{
	"name": "ghana-cities",
	"private": true,
	"version": "0.1.0",
	"license": "CC-BY-SA-4.0",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"start": "node --env-file=.env build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:unit": "vitest",
		"test": "npm run test:unit -- --run",
		"db:setup": "tsx db/setup.ts",
		"db:migrate": "tsx db/migrate.ts",
		"pipeline:download": "tsx pipeline/01-download.ts",
		"pipeline:boundaries": "tsx pipeline/02-boundaries.ts",
		"pipeline:osm": "tsx pipeline/03-osm.ts",
		"pipeline:rasters": "tsx pipeline/04-rasters.ts",
		"pipeline:indicators": "tsx pipeline/05-indicators.ts",
		"pipeline:basemap": "tsx pipeline/06-basemap.ts",
		"pipeline": "npm run pipeline:download && npm run pipeline:boundaries && npm run pipeline:osm && npm run pipeline:rasters && npm run pipeline:heat && npm run pipeline:indicators && npm run pipeline:basemap && npm run pipeline:geoserver",
		"pipeline:geoserver": "tsx pipeline/07-geoserver-publish.ts && tsx pipeline/07b-geoserver-security.ts",
		"portal": "tsx portal-config/build.ts",
		"photos": "tsx scripts/build-photos.ts",
		"deploy:export": "tsx deploy/export-data.ts",
		"pipeline:heat": "tsx pipeline/04b-heat.ts"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@protomaps/basemaps": "^5.7.2",
		"@sveltejs/adapter-node": "^6.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@types/node": "^24",
		"@types/proj4": "^2.5.6",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"globals": "^17.6.0",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"puppeteer-core": "^25.13.0",
		"sharp": "^0.35.5",
		"svelte": "^5.57.1",
		"svelte-check": "^4.6.0",
		"tsx": "^4.23.15",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.1",
		"vite": "^8.3.0",
		"vitest": "^4.1.8"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"dependencies": {
		"@fontsource-variable/atkinson-hyperlegible-next": "^5.3.0",
		"@lucide/svelte": "^1.55.0",
		"geotiff": "^3.0.5",
		"postgres": "^3.4.9",
		"proj4": "^2.22.0"
	}
}
