# Copy to .env and fill in. .env is gitignored.

# PostgreSQL superuser – only used once by the setup script to create the app database/role
POSTGRES_SUPERUSER_PASSWORD=

# App database (created by setup script)
DATABASE_URL=postgres://ghana:CHANGE_ME@localhost:5432/ghana_cities

# GeoServer (runs on port 8081, proxied by the website under /geoserver)
GEOSERVER_URL=http://localhost:8081/geoserver
GEOSERVER_USER=admin
GEOSERVER_PASSWORD=

# Vector basemap: `pmtiles serve` on port 8082, proxied by the website under /basemap
BASEMAP_URL=http://localhost:8082

# NASA FIRMS – free key from https://firms.modaps.eosdis.nasa.gov/api/map_key/ (optional; fire layer stays off without it)
FIRMS_MAP_KEY=

# Public address of the site, read when building (npm run build). Without it the server assumes https://,
# which breaks the map service URLs locally. Set it to the real address before building for deployment.
ORIGIN=http://localhost:3000
